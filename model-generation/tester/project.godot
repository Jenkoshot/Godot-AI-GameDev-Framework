; Model inspection project for model-generation/.
; Loads every .glb sitting in this folder and lets you orbit around them.

config_version=5

[application]

config/name="ModelKit Tester"
run/main_scene="res://inspector.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[rendering]

renderer/rendering_method="forward_plus"
